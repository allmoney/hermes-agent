"""Gateway runtime-metadata footer.

Renders a compact footer showing runtime state (model, context %, cwd) and
appends it to the FINAL message of an agent turn when enabled.  Off by default
to keep replies minimal.

Config (``~/.hermes/config.yaml``)::

    display:
      runtime_footer:
        enabled: true                       # off by default
        fields: [model, context_pct, cwd]   # order shown; drop any to hide

Per-platform overrides live under ``display.platforms.<platform>.runtime_footer``.
Users can toggle the global setting with ``/footer on|off`` from both the CLI
and any gateway platform.

The footer is appended to the final response text in ``gateway/run.py`` right
before returning the response to the adapter send path — so it only lands on
the final message a user sees, not on tool-progress updates or streaming
partials.  When streaming is on and the final text has already been delivered
piecemeal, the footer is sent as a separate trailing message via
``send_trailing_footer()``.

Patches applied (kept across `hermes update`):
  - BUNDLED_PATCH:context-footer-tokens:v1 — K-format context ("38% (38k/256k)")
  - HANDOFF_PATCH_JUL02_FOOTER_PROVIDER    — "provider" field + pool detection
"""

from __future__ import annotations

import os
from typing import Any, Iterable, Optional
from urllib.parse import urlparse

_DEFAULT_FIELDS: tuple[str, ...] = ("model", "context_pct", "cwd")
_SEP = " · "


def _home_relative_cwd(cwd: str) -> str:
    """Return *cwd* with ``$HOME`` collapsed to ``~``.  Empty string if unset."""
    if not cwd:
        return ""
    try:
        home = os.path.expanduser("~")
        p = os.path.abspath(cwd)
        if home and (p == home or p.startswith(home + os.sep)):
            return "~" + p[len(home):]
        return p
    except Exception:
        return cwd


def _model_short(model: Optional[str]) -> str:
    """Drop ``vendor/`` prefix for readability (``openai/gpt-5.4`` → ``gpt-5.4``)."""
    if not model:
        return ""
    return model.rsplit("/", 1)[-1]


def _extract_domain(url: str) -> str:
    """Extract hostname from a base URL (e.g. 'https://morphllm.com/v1' → 'morphllm.com')."""
    if not url:
        return ""
    try:
        raw = url.strip()
        if not raw:
            return ""
        parsed = urlparse(raw if "://" in raw else f"//{raw}")
        return (parsed.hostname or "").lower().rstrip(".") or ""
    except Exception:
        return ""


def _is_pool_provider(provider: Optional[str], base_url: Optional[str]) -> bool:
    """Return True when the agent is talking through our local pool (127.0.0.1:9120).

    jul18 fix: the old `return p == "custom"` fallback was too broad — it
    treated ANY custom provider as the pool, even when base_url pointed to a
    direct upstream (e.g. https://zro.moonmath.ai/v1). This caused the footer
    to show '(pool)' for non-pool providers. Now: if base_url is known, only
    treat as pool when it actually points at 127.0.0.1:9120. The provider=="custom"
    fallback fires ONLY when base_url is genuinely unknown (None/empty).
    """
    bu = (base_url or "").strip().lower()
    if bu:
        # base_url is known — only pool if it points to our local pool.
        return bu.startswith("http://127.0.0.1:9120") and "/v1" in bu
    # base_url unknown — fall back to provider name (jul03: pool key→key
    # rotation can drop base_url on error path, but provider="custom"
    # still indicates the local pool proxy).
    p = (provider or "").strip().lower()
    return p == "custom"




# Domain / alias → models.dev provider id. Used when the footer shows the
# upstream *domain* (from pool X-Pool-Base-Url) rather than a Hermes
# provider name. Without this, knowledge_cutoff always falls through to
# the static config value (e.g. 2026-01) for every pool model.
_DOMAIN_TO_PROVIDER: dict[str, str] = {
    "www.orcarouter.ai": "orcarouter",
    "orcarouter.ai": "orcarouter",
    "api.orcarouter.ai": "orcarouter",
    "openrouter.ai": "openrouter",
    "api.openrouter.ai": "openrouter",
    "api.x.ai": "xai",
    "x.ai": "xai",
    "api.openai.com": "openai",
    "api.anthropic.com": "anthropic",
    "generativelanguage.googleapis.com": "google",
    "api.groq.com": "groq",
    "api.mistral.ai": "mistral",
    "api.deepseek.com": "deepseek",
    "api.minimax.chat": "minimax",
    "api.featherless.ai": "featherless",
    "opencode.ai": "opencode",
    "api.zyloo.io": "openrouter",  # often an OpenRouter-compatible proxy
}


def _provider_candidates(provider: Optional[str], base_url: Optional[str] = None) -> list[str]:
    """Expand a runtime provider label into models.dev provider ids to try."""
    out: list[str] = []
    p = (provider or "").strip().lower()
    if p:
        out.append(p)
        # Strip www. and common prefixes
        if p.startswith("www."):
            out.append(p[4:])
        # Domain → provider map
        mapped = _DOMAIN_TO_PROVIDER.get(p)
        if mapped:
            out.append(mapped)
        # Bare hostname without www
        if p.endswith(".ai") or p.endswith(".com") or p.endswith(".io"):
            # try first label as provider id (orcarouter.ai → orcarouter)
            head = p.split(".")[0]
            if head and head not in ("www", "api"):
                out.append(head)
    if base_url:
        dom = _extract_domain(base_url)
        if dom:
            out.append(dom)
            mapped = _DOMAIN_TO_PROVIDER.get(dom)
            if mapped:
                out.append(mapped)
            head = dom.split(".")[0]
            if head and head not in ("www", "api"):
                out.append(head)
    # Dedup preserve order
    seen: set[str] = set()
    uniq: list[str] = []
    for x in out:
        if x and x not in seen:
            seen.add(x)
            uniq.append(x)
    return uniq


def _model_id_variants(model: Optional[str]) -> list[str]:
    """Generate likely models.dev model-id variants for a bare runtime model name."""
    if not model:
        return []
    m = model.strip()
    variants = [m]
    # Drop vendor/ prefix: "anthropic/claude-opus-4.7" → also bare name
    if "/" in m:
        variants.append(m.rsplit("/", 1)[-1])
        variants.append(m.replace("/", "-"))
    # Dot ↔ dash: claude-opus-4.7 ↔ claude-opus-4-7
    if "." in m:
        variants.append(m.replace(".", "-"))
    if "-" in m:
        # only replace version-like segments carefully: last segment dots
        variants.append(m.replace("-", "."))
    # x-ai/ prefix used by openrouter
    bare = m.rsplit("/", 1)[-1]
    for prefix in ("x-ai/", "xai/", "anthropic/", "openai/", "google/", "meta-llama/"):
        variants.append(prefix + bare)
        variants.append(prefix + bare.replace(".", "-"))
        variants.append(prefix + bare.replace("-", "."))
    seen: set[str] = set()
    uniq: list[str] = []
    for v in variants:
        if v and v not in seen:
            seen.add(v)
            uniq.append(v)
    return uniq


def _lookup_knowledge_cutoff(
    provider: Optional[str],
    model: Optional[str],
    *,
    base_url: Optional[str] = None,
    config_fallback: Optional[str] = None,
) -> str:
    """Resolve per-model knowledge cutoff.

    Lookup order (HANDOFF_PATCH_JUL11_KC_PER_MODEL):
      1. models.dev registry — provider candidates × model-id variants,
         then cross-provider scan by bare model name (pool domain case:
         display_provider=www.orcarouter.ai, model=claude-opus-4.7).
      2. config fallback (display.runtime_footer.knowledge_cutoff) — ONLY
         when the model is completely unknown to the registry.
      3. HERMES_KNOWLEDGE_CUTOFF env — hard FORCE for ALL models. Use
         sparingly; a global static date (e.g. 2026-01) is wrong for a
         multi-model pool. Prefer unsetting the env and relying on (1)/(2).

    If the model IS found in the registry but has an empty knowledge
    field, return "" (do NOT invent the config date — that was the
    jul11 bug: every pool model showed 📅2026-01).
    """
    if not model:
        env_kc = (os.environ.get("HERMES_KNOWLEDGE_CUTOFF", "") or "").strip()
        if env_kc:
            return env_kc
        return (config_fallback or "").strip()

    try:
        from agent.models_dev import fetch_models_dev, get_model_info
    except Exception:
        env_kc = (os.environ.get("HERMES_KNOWLEDGE_CUTOFF", "") or "").strip()
        return env_kc or (config_fallback or "").strip()

    found_model = False  # True once any registry entry matches this model

    # 1a. Direct get_model_info with provider candidates × model variants
    for prov in _provider_candidates(provider, base_url):
        for mid in _model_id_variants(model):
            try:
                info = get_model_info(prov, mid)
            except Exception:
                info = None
            if info:
                found_model = True
                kc = (getattr(info, "knowledge_cutoff", "") or "").strip()
                if kc:
                    return kc
                # Found entry but empty knowledge — keep scanning for a
                # better hit (e.g. native anthropic entry over aggregator).

    # 1b. Cross-provider scan by model-id variants (pool domain case).
    # Prefer native providers (anthropic/openai/xai/google) over aggregators.
    try:
        data = fetch_models_dev() or {}
    except Exception:
        data = {}

    preferred_order = (
        "anthropic", "openai", "xai", "google", "gemini", "orcarouter",
        "openrouter", "vercel", "requesty",
    )
    variants_lower = {v.lower() for v in _model_id_variants(model)}
    bare = (model.rsplit("/", 1)[-1] if model else "").lower()

    def _norm(s: str) -> str:
        return s.replace(".", "-").replace("_", "-")

    variants_norm = {_norm(v) for v in variants_lower}
    bare_norm = _norm(bare)
    hits: list[tuple[int, str]] = []  # (rank, kc)

    for pid, pdata in data.items():
        if not isinstance(pdata, dict):
            continue
        models = pdata.get("models") or {}
        if not isinstance(models, dict):
            continue
        for mid, mdata in models.items():
            if not isinstance(mdata, dict):
                continue
            mid_l = mid.lower()
            bare_mid = mid_l.rsplit("/", 1)[-1]
            if (
                mid_l not in variants_lower
                and bare_mid != bare
                and mid_l != bare
                and _norm(bare_mid) != bare_norm
                and _norm(mid_l) not in variants_norm
            ):
                continue
            found_model = True
            kc = (mdata.get("knowledge") or "").strip()
            if not kc:
                continue
            try:
                rank = preferred_order.index(pid)
            except ValueError:
                rank = 100
            hits.append((rank, kc))

    if hits:
        hits.sort(key=lambda x: x[0])
        return hits[0][1]

    # Model known to registry but no knowledge field anywhere → empty
    # (do not invent config date).
    if found_model:
        return ""

    # 2/3. Unknown model: config fallback, then env force.
    cfg = (config_fallback or "").strip()
    if cfg:
        return cfg
    return (os.environ.get("HERMES_KNOWLEDGE_CUTOFF", "") or "").strip()


def resolve_footer_config(
    user_config: dict[str, Any] | None,
    platform_key: str | None = None,
) -> dict[str, Any]:
    """Resolve effective runtime-footer config for *platform_key*.

    Merge order (later wins):
        1. Built-in defaults (enabled=False)
        2. ``display.runtime_footer``
        3. ``display.platforms.<platform_key>.runtime_footer``
    """
    resolved = {"enabled": False, "fields": list(_DEFAULT_FIELDS)}
    cfg = (user_config or {}).get("display") or {}

    global_cfg = cfg.get("runtime_footer")
    if isinstance(global_cfg, dict):
        if "enabled" in global_cfg:
            resolved["enabled"] = bool(global_cfg.get("enabled"))
        if isinstance(global_cfg.get("fields"), list) and global_cfg["fields"]:
            resolved["fields"] = [str(f) for f in global_cfg["fields"]]
        if global_cfg.get("knowledge_cutoff"):
            resolved["knowledge_cutoff"] = str(global_cfg.get("knowledge_cutoff"))

    if platform_key:
        platforms = cfg.get("platforms") or {}
        plat_cfg = platforms.get(platform_key)
        if isinstance(plat_cfg, dict):
            plat_footer = plat_cfg.get("runtime_footer")
            if isinstance(plat_footer, dict):
                if "enabled" in plat_footer:
                    resolved["enabled"] = bool(plat_footer.get("enabled"))
                if isinstance(plat_footer.get("fields"), list) and plat_footer["fields"]:
                    resolved["fields"] = [str(f) for f in plat_footer["fields"]]
                if plat_footer.get("knowledge_cutoff"):
                    resolved["knowledge_cutoff"] = str(plat_footer.get("knowledge_cutoff"))

    return resolved


def _format_latency(seconds: float) -> str:
    """Humanize a turn duration: ``<1s``, ``22s``, ``1m05s``."""
    if seconds < 1:
        return "<1s"
    total = int(round(seconds))
    if total < 60:
        return f"{total}s"
    m, sec = divmod(total, 60)
    return f"{m}m{sec:02d}s"


def format_runtime_footer(
    *,
    model: Optional[str],
    context_tokens: int,
    context_length: Optional[int],
    cwd: Optional[str] = None,
    fields: Iterable[str] = _DEFAULT_FIELDS,
    # HANDOFF_PATCH_JUL02_FOOTER_PROVIDER: extra kwargs (upstream removed them)
    provider: Optional[str] = None,
    base_url: Optional[str] = None,
    pool_model: Optional[str] = None,
    pool_base_url: Optional[str] = None,
    knowledge_cutoff_config: Optional[str] = None,
    turn_seconds: Optional[float] = None,
) -> str:
    """Render the footer line, or return "" if no fields have data.

    Fields are skipped silently when their underlying data is missing — a
    partially-populated footer is better than a line with ``?%`` or empty slots.
    """
    # HANDOFF_PATCH_JUL02_FOOTER_PROVIDER: when routing through local pool,
    # surface the real upstream model + provider domain (otherwise the user
    # always sees the generic "llm-pool-model" + "custom").
    pool = _is_pool_provider(provider, base_url)
    display_model = model
    display_provider = provider
    display_context_length = context_length
    if pool:
        if pool_model:
            display_model = pool_model
        if pool_base_url:
            display_provider = _extract_domain(pool_base_url)
        # Recalc context_length for the real upstream model — the agent's
        # context_length is based on the pool placeholder, not the actual model.
        if pool_model:
            try:
                from agent.model_metadata import get_model_context_length
                real_ctx = get_model_context_length(
                    pool_model,
                    base_url=pool_base_url or "",
                    config_context_length=None,
                )
                if real_ctx and real_ctx > 0:
                    display_context_length = real_ctx
            except Exception:
                pass

    parts: list[str] = []
    for field in fields:
        if field == "model":
            m = _model_short(display_model)
            if m:
                parts.append(m)
        elif field == "provider":
            p = (display_provider or "").strip()
            if pool and not p:
                p = "custom"
            if pool or p:
                parts.append(f"🏁{p} (pool)" if pool else f"🏁{p}")
        elif field == "context_pct":
            if display_context_length and display_context_length > 0 and context_tokens >= 0:
                pct = max(0, min(100, round((context_tokens / display_context_length) * 100)))
                # BUNDLED_PATCH:context-footer-tokens:v1 — show K-format tokens
                ctx_k = f"{context_tokens // 1000}k" if context_tokens >= 1000 else str(context_tokens)
                len_k = f"{display_context_length // 1000}k" if display_context_length >= 1000 else str(display_context_length)
                parts.append(f"{pct}% ({ctx_k}/{len_k})")
        elif field == "latency":
            # Wall-clock turn duration. Skipped when the caller supplied no
            # timing (call sites that don't measure) or the value is negative.
            if turn_seconds is not None and turn_seconds >= 0:
                parts.append(_format_latency(turn_seconds))
        elif field == "cwd":
            rel = _home_relative_cwd(cwd or os.environ.get("TERMINAL_CWD", ""))
            if rel:
                parts.append(rel)
        elif field == "knowledge_cutoff":
            # Per-model knowledge cutoff. Lookup is model-aware so pool
            # routing (display_provider=www.orcarouter.ai) still resolves
            # the real date for the upstream model instead of the static
            # config fallback (which used to show 📅2026-01 for every model).
            # HANDOFF_PATCH_JUL11_KC_PER_MODEL
            kc = _lookup_knowledge_cutoff(
                display_provider or provider,
                display_model or model,
                base_url=pool_base_url or base_url,
                config_fallback=knowledge_cutoff_config,
            )
            if kc:
                parts.append(f"📅{kc}")
        # HANDOFF_PATCH_JUL05_AUTO_HANDOFF: optional `handoff_warning` field.
        # Renders `⚠️ /new` when the running total has crossed the auto-handoff
        # threshold (default 80% of context_length, overridable). Fail-open: if
        # auto_handoff can't be imported, this field is silently dropped.
        # Re-applied after upstream 7203898ce dropped the field branch.
        elif field == "handoff_warning":
            try:
                from agent.auto_handoff import format_handoff_warning_footer as _fh
                w = _fh(
                    context_tokens=context_tokens,
                    context_length=context_length,
                )
                if w:
                    parts.append(w)
            except Exception:
                pass
        # Unknown field names are silently ignored.

    if not parts:
        return ""
    return _SEP.join(parts)


def build_footer_line(
    *,
    user_config: dict[str, Any] | None,
    platform_key: str | None,
    model: Optional[str],
    context_tokens: int,
    context_length: Optional[int],
    cwd: Optional[str] = None,
    # HANDOFF_PATCH_JUL02_FOOTER_PROVIDER: passthroughs
    provider: Optional[str] = None,
    base_url: Optional[str] = None,
    pool_model: Optional[str] = None,
    pool_base_url: Optional[str] = None,
    turn_seconds: Optional[float] = None,
) -> str:
    """Top-level entry point used by gateway/run.py.

    Returns the footer text (empty string when disabled or no data).  Callers
    append this to the final response themselves, preserving a single blank
    line of separation.
    """
    cfg = resolve_footer_config(user_config, platform_key)
    if not cfg.get("enabled"):
        return ""
    # HANDOFF_PATCH_JUL02_FOOTER_PROVIDER: config fallback for missing
    # runtime provider/base_url (pool_key→key rotation drops them on error
    # path).  config.yaml stores them under model.* namespace, not top-level.
    if user_config is not None:
        _m = user_config.get("model") or {}
        if not provider:
            provider = _m.get("provider")
        if not base_url:
            base_url = _m.get("base_url")
    return format_runtime_footer(
        model=model,
        context_tokens=context_tokens,
        context_length=context_length,
        cwd=cwd,
        fields=cfg.get("fields") or _DEFAULT_FIELDS,
        provider=provider,
        base_url=base_url,
        pool_model=pool_model,
        pool_base_url=pool_base_url,
        knowledge_cutoff_config=cfg.get("knowledge_cutoff"),
        turn_seconds=turn_seconds,
    )
